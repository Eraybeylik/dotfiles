/***
 *    ┓ ┏┏┓┓┏┳┓┏┓┳┓  ┳┓┓ ┳┳┏┓┓┏  ┏┓┏┓┳┓┏┓┳┏┓
 *    ┃┃┃┣┫┗┫┣┫┣┫┣┫━━┣┫┃ ┃┃┗┓┣┫━━┃ ┃┃┃┃┣ ┃┃┓
 *    ┗┻┛┛┗┗┛┻┛┛┗┛┗  ┻┛┗┛┗┛┗┛┛┗  ┗┛┗┛┛┗┻ ┻┗┛
 *                                          
 */

 {
	 "layer": "bottom",
	 "position": "top",
	 "height": 40,
	 "exclusive": true,
	 "gtk-layer-shell": true,
	 "passthrough": false,
	 "fixed-center": true,
	 "modules-left": ["custom/launcher", "hyprland/workspaces", "group/utils"],
	 "modules-center": ["group/media", "custom/notification", "battery"],
	 "modules-right": [
		 "group/hardware",
		 "group/connect",
		 "group/audio",
		 "group/power",
		 "clock",
		 "clock#simpleclock",
		 "tray"
	 ],

	 // ---------- groups (drawer = extra modules slide out on hover) ----------
	 "group/utils": {
		 "orientation": "horizontal",
		 "modules": ["custom/pacman", "custom/weather", "custom/colorpicker"]
	 },
	 "group/hardware": {
		 "orientation": "horizontal",
		 "drawer": { "transition-duration": 300, "transition-left-to-right": false },
		 "modules": ["cpu", "memory", "temperature", "custom/gpu"]
	 },
	 "group/connect": {
		 "orientation": "horizontal",
		 "modules": ["network", "bluetooth"]
	 },
	 "group/audio": {
		 "orientation": "horizontal",
		 "drawer": { "transition-duration": 300, "transition-left-to-right": false },
		 "modules": ["pulseaudio", "pulseaudio#mic", "custom/brightness"]
	 },
	 "group/media": {
		 "orientation": "horizontal",
		 "drawer": { "transition-duration": 300, "transition-left-to-right": true },
		 "modules": ["custom/media", "custom/media-prev", "custom/media-toggle", "custom/media-next"]
	 },
	 "group/power": {
		 "orientation": "horizontal",
		 "modules": ["power-profiles-daemon", "custom/caffeine"]
	 },

	 "temperature": {
		 "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
		 "input-filename": "temp1_input",
		 "critical-threshold": 80,
		 "interval": 5,
		 "format": " {temperatureC}°",
		 "tooltip-format": "CPU (Tctl): {temperatureC}°C"
	 },
	 "custom/gpu": {
		 "exec": "~/.config/waybar/scripts/gpu.sh",
		 "return-type": "json",
		 "interval": 5,
		 "tooltip": true
	 },
	 "bluetooth": {
		 "format": "󰂯",
		 "format-off": "󰂲",
		 "format-disabled": "󰂲",
		 "format-connected": "󰂱",
		 "format-connected-battery": "󰂱 {device_battery_percentage}%",
		 "tooltip-format": "{controller_alias}: {status}",
		 "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
		 "tooltip-format-enumerate-connected": "{device_alias}",
		 "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
		 "on-click": "blueman-manager",
		 "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
	 },
	 "pulseaudio#mic": {
		 "format": "{format_source}",
		 "format-source": "󰍬",
		 "format-source-muted": "󰍭",
		 "tooltip-format": "Mic: {source_volume}% ({source_desc})",
		 "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		 "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
		 "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
	 },
	 "custom/brightness": {
		 "exec": "~/.config/waybar/scripts/brightness.sh get",
		 "return-type": "json",
		 "interval": 30,
		 "signal": 10,
		 "on-scroll-up": "~/.config/waybar/scripts/brightness.sh up",
		 "on-scroll-down": "~/.config/waybar/scripts/brightness.sh down"
	 },
	 "custom/media-prev": {
		 "format": "󰒮",
		 "tooltip": false,
		 "on-click": "playerctl previous"
	 },
	 "custom/media-toggle": {
		 "exec": "~/.config/waybar/scripts/media-toggle.sh",
		 "format": "{}",
		 "tooltip": false,
		 "on-click": "playerctl play-pause"
	 },
	 "custom/media-next": {
		 "format": "󰒭",
		 "tooltip": false,
		 "on-click": "playerctl next"
	 },
	 "power-profiles-daemon": {
		 "format": "{icon}",
		 "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		 "format-icons": {
			 "default": "󰗑",
			 "performance": "󰓅",
			 "balanced": "󰗑",
			 "power-saver": "󰌪"
		 }
	 },

	 "custom/media": {
		 "exec": "~/.config/waybar/scripts/media.sh",
		 "return-type": "json",
		 "escape": true,
		 "on-click": "playerctl play-pause",
		 "on-scroll-up": "playerctl previous",
		 "on-scroll-down": "playerctl next",
		 "on-click-right": "swaync-client -t -sw"
	 },
	 "hyprland/workspaces": {
		 "on-click": "activate",
		 // only occupied + active workspaces, each with its app icons
		 // icons start with a no-break space: a normal space lets GTK wrap the label and grow the bar
		 "format": "{name}{windows}",
		 "format-window-separator": "",
		 "window-rewrite-default": " ",
		 "window-rewrite": {
			 "class<kitty>": " ",
			 "class<[Gg]oogle-chrome>": " ",
			 "class<firefox>": " 󰈹",
			 "class<chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default>": " 󰖣",
			 "class<chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default>": " 󰗃",
			 "class<chrome-olhlgjciiahedchpagffikcmgfakknfd-Default>": " ",
			 "class<chrome-gdjmlkllihelgjmceikmaaddbjkcbnoe-Default>": " ",
			 "class<chrome-hbblfifohofgngfbjbiimbbcimepbdcb-Default>": " 󰚩",
			 "class<chrome-dbcelemodfinaiomagjnllgjioiaolnj-Default>": " 󰏊",
			 "class<md.obsidian.Obsidian|obsidian>": " ",
			 "class<com.microsoft.VSCode|[Cc]ode|code-oss>": " ",
			 "class<jetbrains-pycharm.*>": " ",
			 "class<opencode-desktop|[Aa]ntigravity>": " 󰅩",
			 "class<[Ss]ubl|sublime_text>": " ",
			 "class<claude-desktop|[Cc]laude>": " ",
			 "class<discord|vesktop>": " 󰙯",
			 "class<thunar|Thunar>": " ",
			 "class<file-roller|org.gnome.FileRoller>": " ",
			 "class<Bitwarden|bitwarden>": " 󰌆",
			 "class<[Aa]nki>": " 󰂺",
			 "class<libreoffice-writer>": " ",
			 "class<libreoffice-calc>": " ",
			 "class<libreoffice-impress>": " ",
			 "class<libreoffice-.*|soffice>": " ",
			 "class<org.qbittorrent.qBittorrent|qbittorrent>": " 󰇚",
			 "class<virt-manager|.*[Vv]irt-viewer|remote-viewer>": " 󰍹",
			 "class<org.remmina.Remmina|[Aa]ny[Dd]esk|anydesk>": " 󰢹",
			 "class<org.kde.gwenview>": " ",
			 "class<org.gnome.Loupe>": " ",
			 "class<qimgv|imv>": " 󰋩",
			 "class<mpv>": " ",
			 "class<vlc>": " 󰕼",
			 "class<pavucontrol|org.pulseaudio.pavucontrol>": " 󰕾",
			 "class<blueman-manager|.*blueman.*>": " ",
			 "class<org.kde.kdeconnect.*>": " ",
			 "class<nwg-look>": " ",
			 "class<kvantummanager|qt5ct|qt6ct>": " ",
			 "class<waypaper>": " 󰸉",
			 "class<warp-taskbar|com.cloudflare.*>": " ",
			 "class<com.raspberrypi.rpi-imager|rpi-imager>": " 󰐿",
			 "class<5ire>": " 󰚩"
		 },
		 "all-outputs": false,
		 "disable-scroll": false,
		 "active-only": false
	 },
	 "tray": {
		 "show-passive-items": true,
		 "spacing": 10
	 },
	 "clock#simpleclock": {
		 "tooltip": true,
		 "timezones": ["Europe/Istanbul", "Etc/UTC", "Europe/London", "America/New_York", "Asia/Tokyo"],
		 "tooltip-format": "{tz_list}",
		 "format": " {:%H:%M}"
	 },
	 "clock": {
		 "format": " {:L%a %d %b}",
		 "calendar": {
			 "mode": "month",
			 "mode-mon-col": 3,
			 "weeks-pos": "left",
			 "on-scroll": 1,
			 "format": {
				 "weeks": "<i>W{}</i>",
				 "today": "<b><u>{}</u></b>"
			 }
		 },
		 "actions": {
			 "on-click-right": "mode",
			 "on-scroll-up": "shift_down",
			 "on-scroll-down": "shift_up"
		 },
		 "tooltip-format": "<span font='GeistMono Nerd Font 14'><tt><small>{calendar}</small></tt></span>"
	 },
	 "cpu": {
		 "format": " {usage}%",
		 "tooltip": true,
		 "interval": 1
	 },
	 "memory": {
		 "format": " {used:0.1f}Gi"
	 },
	 "pulseaudio": {
		 "format": "{icon} {volume}%",
		 "format-muted": " muted",
		 "format-icons": {
			 "headphone": "",
			 "default": ["", "", ""]
		 },
		 "scroll-step": 5,
		 "on-click": "pavucontrol",
		 "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	 },
  	"network": {
		"format-wifi": "",
		"format-ethernet":"",
		"format-disconnected": "",
		"tooltip-format-disconnected": "Disconnected",
		"interval": 2,
		"format-alt": "󰁅 {bandwidthDownBytes} 󰁝 {bandwidthUpBytes}",
		"format-alt-click": "click-right",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"on-click": "kitty --title KittyNmtui sh -c '. ~/.config/nmtui-colors.sh; sleep 0.1; nmtui'"
    },
	 "custom/sep": {
		 "format": "|",
		 "tooltip": false
	 },
	 "custom/caffeine": {
		 "format": "{}",
		 "return-type": "json",
		 "interval": "once",
		 "exec": "~/.config/hypr/scripts/caffeine.sh status",
		 "on-click": "~/.config/hypr/scripts/caffeine.sh toggle",
		 "signal": 9,
		 "tooltip": true
	 },
	 "custom/launcher": {
		 "tooltip": false,
		 "on-click": "~/.config/rofi/scripts/sidelauncher",
		 "format": "󰣇"
	 },
	 "custom/notification": {
		 "tooltip": true,
		 "tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
		 "format": "{} {icon}",
		 "format-icons": {
			 "notification": "<span foreground='red'><sup></sup></span>",
			 "none": "",
			 "dnd-notification": "<span foreground='red'><sup></sup></span>",
			 "dnd-none": "",
			 "inhibited-notification": "<span foreground='red'><sup></sup></span>",
			 "inhibited-none": "",
			 "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
			 "dnd-inhibited-none": ""
		 },
		 "return-type": "json",
		 "exec-if": "which swaync-client",
		 "exec": "swaync-client -swb",
		 "on-click": "sleep 0.1 && swaync-client -t -sw",
		 "on-click-right": "swaync-client -d -sw",
		 "escape": true
	 },
	 "custom/weather": {
		 "format": "{}",
		 "format-alt": "{alt}: {}",
		 "format-alt-click": "click",
		 "interval": 1800,
		 "return-type": "json",
		 "exec": "$HOME/.config/waybar/scripts/Weather.py",
	    	 //"exec": "$HOME/.config/hypr/UserScripts/Weather.sh",
	    	 //"exec-if": "ping wttr.in -c1",
	    	 "tooltip": true
	 },
	 "custom/colorpicker": {
		 "format": "{}",
		 "return-type": "json",
		 "interval": "once",
		 "exec": "~/.config/waybar/scripts/Colorpicker.sh -j",
		 "on-click": "~/.config/waybar/scripts/Colorpicker.sh",
		 "signal": 1
	 },
	 "custom/pacman": {
		 "format": "󰅢 {}",
		 "interval": 1800,
		 "return-type": "json",
		 "exec": "~/.config/waybar/scripts/updates.sh",
		 "on-click": "kitty --title PacUpdate sh -c 'sleep 0.1; yay -Syu; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
		 "signal": 8,
		 "tooltip": true
	 },
	 "battery": {
		 "interval": 60,
		 "align": 0,
		 "rotate": 0,
		 "full-at": 100,
		 "design-capacity": false,
		 "states": {
			 "good": 95,
			 "warning": 30,
			 "critical": 15
		 },
		 "format": "{icon} {capacity}%",
		 "format-charging": " {capacity}%",
		 "format-plugged": " {capacity}%",
		 "format-full": "{icon} Full",
		 "format-alt": "{icon} {time}",
		 "format-icons": ["", "", "", "", ""],
		 "format-time": "{H}h {M}min",
		 "tooltip": true
	 }




 }
