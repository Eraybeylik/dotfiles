// tty: airy three-zone bar. Left: workspaces + window. Center: clock. Right: status, then toggles.
{
	"layer": "bottom",
	"position": "top",
	"height": 32,
	"exclusive": true,
	"gtk-layer-shell": true,
	"passthrough": false,
	"fixed-center": true,

	"modules-left": ["hyprland/workspaces", "hyprland/window"],
	"modules-center": ["clock"],
	"modules-right": [
		"custom/media",
		"cpu",
		"memory",
		"network#vpn-tun",
		"network#vpn-wg",
		"network",
		"pulseaudio",
		"battery",
		"custom/nightlight",
		"custom/ebook",
		"custom/caffeine",
		"power-profiles-daemon",
		"custom/notification",
		"tray"
	],

	"hyprland/workspaces": {
		"on-click": "activate",
		"format": "{id}",
		"all-outputs": false
	},
	"hyprland/window": {
		"format": "{title}",
		"max-length": 48,
		"separate-outputs": true,
		"tooltip": false
	},

	"clock": {
		"interval": 30,
		"format": "{0:%H:%M}  <span alpha='55%'>{0:%a %d %b}</span>",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": { "mode": "month", "weeks-pos": "left", "format": { "today": "<b><u>{}</u></b>" } },
		"actions": { "on-click-right": "mode", "on-scroll-up": "shift_down", "on-scroll-down": "shift_up" }
	},

	"custom/media": {
		"exec": "~/.config/waybar/scripts/media.sh",
		"return-type": "json",
		"escape": true,
		"max-length": 36,
		"on-click": "playerctl play-pause",
		"on-scroll-up": "playerctl previous",
		"on-scroll-down": "playerctl next"
	},
	"cpu": {
		"interval": 2,
		"format": "<span alpha='50%'>󰻠</span> {usage}%",
		"tooltip": false
	},
	"memory": {
		"interval": 3,
		"format": "<span alpha='50%'>󰍛</span> {used:0.1f}G",
		"tooltip-format": "{used:0.1f}G / {total:0.1f}G\nswap {swapUsed:0.1f}G"
	},
	"network": {
		"interval": 2,
		"format-wifi": "<span alpha='50%'>󰖩</span> {essid}",
		"format-ethernet": "<span alpha='50%'>󰈀</span> {ifname}",
		"format-disconnected": "󰖪 off",
		"max-length": 18,
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"on-click": "kitty --title KittyNmtui sh -c '. ~/.config/nmtui-colors.sh; sleep 0.1; nmtui'"
	},
	// VPN: hidden unless the tunnel is up (HTB openvpn = tun*, wireguard = wg*)
	"network#vpn-tun": {
		"interface": "tun*",
		"interval": 5,
		"format": "󰖂 {ipaddr}",
		"format-disconnected": "",
		"format-linked": "",
		"tooltip-format": "{ifname}: {ipaddr}"
	},
	"network#vpn-wg": {
		"interface": "wg*",
		"interval": 5,
		"format": "󰖂 {ipaddr}",
		"format-disconnected": "",
		"format-linked": "",
		"tooltip-format": "{ifname}: {ipaddr}"
	},
	"pulseaudio": {
		"format": "<span alpha='50%'>{icon}</span> {volume}%",
		"format-muted": "󰖁 muted",
		"format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
		"scroll-step": 5,
		"on-click": "pavucontrol",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	},
	"battery": {
		"interval": 30,
		"states": { "warning": 30, "critical": 15 },
		"format": "<span alpha='50%'>{icon}</span> {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": "󰂄 {capacity}%",
		"format-full": "󰁹 full",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
		"tooltip-format": "{timeTo}"
	},

	"custom/nightlight": {
		"exec": "~/.config/hypr/scripts/screen-filter.sh status warm",
		"return-type": "json",
		"interval": "once",
		"signal": 11,
		"on-click": "~/.config/hypr/scripts/screen-filter.sh warm"
	},
	"custom/ebook": {
		"exec": "~/.config/hypr/scripts/screen-filter.sh status grayscale",
		"return-type": "json",
		"interval": "once",
		"signal": 11,
		"on-click": "~/.config/hypr/scripts/screen-filter.sh grayscale"
	},
	"custom/caffeine": {
		"format": "{}",
		"return-type": "json",
		"interval": "once",
		"exec": "~/.config/hypr/scripts/caffeine.sh status",
		"on-click": "~/.config/hypr/scripts/caffeine.sh toggle",
		"signal": 9,
		"tooltip": true
	},
	"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"format-icons": { "default": "󰗑", "performance": "󰓅", "balanced": "󰗑", "power-saver": "󰌪" }
	},
	"custom/notification": {
		"tooltip": true,
		"tooltip-format": "Left Click: Notification Center\nRight Click: Do not Disturb",
		"format": "{icon}",
		"format-icons": {
			"notification": "󰂚", "none": "󰂚",
			"dnd-notification": "󰂛", "dnd-none": "󰂛",
			"inhibited-notification": "󰂚", "inhibited-none": "󰂚",
			"dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	"tray": { "show-passive-items": true, "spacing": 10, "icon-size": 15 }
}
