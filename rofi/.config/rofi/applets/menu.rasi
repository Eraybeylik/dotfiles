/***
 *    ┳┳┓┏┓┳┓┳┳
 *    ┃┃┃┣ ┃┃┃┃
 *    ┛ ┗┗┛┛┗┗┛
 *
 * Compact centered text-list theme, used by sysmenu.sh, webapp.sh and
 * keybinds-cheatsheet.sh (the cheatsheet widens it via -theme-str).
 */

configuration {
    show-icons:                  false;
}

@import '~/.config/rofi/applets/shared/colors.rasi'
@import '~/.config/rofi/applets/shared/fonts.rasi'

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       26em;
    border:                      2px;
    border-radius:               16px;
    border-color:                @border-color;
    background-color:            @background-alpha;
    cursor:                      "default";
}

mainbox {
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
    spacing:                     12px;
    padding:                     16px;
}

inputbar {
    children:                    [ "textbox-prompt", "entry" ];
    orientation:                 horizontal;
    background-color:            @background-alt;
    border-radius:               10px;
    padding:                     10px 14px;
    spacing:                     8px;
}

textbox-prompt {
    expand:                      false;
    content:                     "";
    background-color:            transparent;
    text-color:                  @active;
}

entry {
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           @foreground;
    background-color:            transparent;
    text-color:                  @foreground;
}

listview {
    columns:                     1;
    lines:                       8;
    layout:                      vertical;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    fixed-height:                false;
    background-color:            transparent;
    spacing:                     4px;
}

element {
    cursor:                      pointer;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @foreground;
    padding:                     10px 14px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
